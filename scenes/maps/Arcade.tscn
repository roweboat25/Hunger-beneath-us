[node name="NpcAttendant" type="Area2D" parent="Actors"]
position = Vector2(784, 92)
script = ExtResource("5_npc")
id = "attendant"
sprite_sheet = "res://assets/sprites/seth.png"
facing = "down"
metadata/say = "'Tickets for prizes. Fifty for a phone, two hundred for the box.' He didn't say what was in the box. 'The kids' table is free.'"
metadata/scan = "RED ROCK AMUSEMENTS\nPsyon: none\nframes: NONE\nshift: all of them"
metadata/scan_name = "The attendant"

[node name="Shape" type="CollisionShape2D" parent="Actors/NpcAttendant"]
