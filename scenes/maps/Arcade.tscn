[node name="NpcRegular" type="Area2D" parent="Actors"]
position = Vector2(432, 156)
script = ExtResource("5_npc")
id = "regular"
sprite_sheet = "res://assets/sprites/forner.png"
facing = "up"
metadata/say = "'Tower Run. Don't bother, it's rigged. You run up the stairs and the eye's at the top of every floor and the game ends when you look at it.' He put another coin in."
metadata/scan = "UNREGISTERED\nORA frames: NONE\ncredit: 212 tickets\nhigh score: TOWER RUN"
