[node name="NpcKidA" type="Area2D" parent="Actors"]
position = Vector2(80, 348)
script = ExtResource("5_npc")
id = "kid_a"
sprite_sheet = "res://assets/sprites/mira.png"
facing = "down"
metadata/say = "'You're too old for it.' She didn't look up from the tablet. 'It only does your homework if you've got homework.'"
metadata/scan = "HEIGHTS PRIMARY - YEAR 6\nPsyon 4.1 - sync 97%\nforeground app: THE PASSWORD GAME\nround: 7"
metadata/scan_name = "A schoolgirl"
metadata/speaker = "Schoolgirl"

[node name="Shape" type="CollisionShape2D" parent="Actors/NpcKidA"]
position = Vector2(0, -16)
shape = SubResource("Rect_32x32")

[node name="NpcKidB" type="Area2D" parent="Actors"]
position = Vector2(144, 348)
script = ExtResource("5_npc")
id = "kid_b"
sprite_sheet = "res://assets/sprites/ezra.png"
facing = "down"
metadata/say = "'Mira Drake's dad? She's the best at it. She got to round eight. Nobody gets to round eight.'"
metadata/scan = "HEIGHTS PRIMARY - YEAR 6\nPsyon 4.1 - sync 94%\nforeground app: THE PASSWORD GAME\nround: 5"
metadata/scan_name = "A schoolboy"
metadata/speaker = "Schoolboy"

[node name="Shape" type="CollisionShape2D" parent="Actors/NpcKidB"]
position = Vector2(0, -16)
shape = SubResource("Rect_32x32")

[node name="NpcDancer" type="Area2D" parent="Actors"]
position = Vector2(272, 252)
script = ExtResource("5_npc")
id = "dancer"
sprite_sheet = "res://assets/sprites/ezra.png"
facing = "down"
metadata/say = "She was dancing to nothing. The speakers were off. 'Four notes,' she said, stepping them out on the pad. 'Up, down, left, right. It's always the same four.'"
metadata/scan = "TOKZ - CREATOR\nPsyon 4.1 - sync 100%\nlast post: the pad, 4 notes\nframes: ON"
metadata/scan_name = "A dancer"
metadata/bad = true

[node name="Shape" type="CollisionShape2D" parent="Actors/NpcDancer"]
