position = Vector2(464, 188)
script = ExtResource("5_npc")
id = "mimic"
sprite_sheet = "res://assets/sprites/carl.png"
facing = "down"
metadata/min_connection = 50
metadata/scan = "DRAKE, C. - PSYONIC INTEGRATIONS\nPsyon 4.1 - sync 100%\nstatus: WAITING FOR YOU"
metadata/scan_bad = true
metadata/scan_name = "Carl Drake"

[node name="Shape" type="CollisionShape2D" parent="Actors/NpcMimic"]
