[node name="NpcHandler" type="Area2D" parent="Actors"]
position = Vector2(976, 220)
script = ExtResource("5_npc")
id = "handler"
sprite_sheet = "res://assets/sprites/tyson.png"
facing = "down"
metadata/scan = "UNREGISTERED\nORA frames: DISABLED\nPsyon: none\nwarrants: 3"
metadata/scan_name = "A handler"
metadata/scan_bad = true
metadata/say = "'You holding? No? You want to be.' He had the frames pushed up on his head like sunglasses. 'K's cheaper than a Psyon session, and it doesn't talk back.'"

[node name="Shape" type="CollisionShape2D" parent="Actors/NpcHandler"]
position = Vector2(0, -16)
shape = SubResource("Rect_32x32")

[node name="NpcPartierA" type="Area2D" parent="Actors"]
position = Vector2(1424, 348)
script = ExtResource("5_npc")
id = "partier_a"
sprite_sheet = "res://assets/sprites/ezra.png"
facing = "right"
metadata/scan = "TOKZ - CREATOR\nPsyon 4.1 - sync 74%\nfollowers: 2,114\nlast post: 11 min ago"
metadata/scan_name = "A partier"
metadata/say = "'Lushon's is dead tonight. Basement's where it's at. Don't go down there with those on, though.' She tapped her own temple. 'They don't like it when the frames are watching.'"

[node name="Shape" type="CollisionShape2D" parent="Actors/NpcPartierA"]
position = Vector2(0, -16)
shape = SubResource("Rect_32x32")

[node name="NpcPartierB" type="Area2D" parent="Actors"]
position = Vector2(1456, 348)
script = ExtResource("5_npc")
id = "partier_b"
sprite_sheet = "res://assets/sprites/seth.png"
facing = "left"
metadata/scan = "SALTECH - ORDERLY\nPsyon 4.1 - sync 61%\nshift: 06:00"
metadata/scan_name = "A partier"
metadata/say = "'Every weekend, man. The plaza's the only place the tower lets you forget the tower. Then Monday the frames go back on and you're a brand again.'"

[node name="Shape" type="CollisionShape2D" parent="Actors/NpcPartierB"]
position = Vector2(0, -16)
shape = SubResource("Rect_32x32")

[node name="NpcFighterA" type="Area2D" parent="Actors"]
position = Vector2(1328, 476)
script = ExtResource("5_npc")
id = "fighter_a"
sprite_sheet = "res://assets/sprites/tyson.png"
facing = "right"
metadata/scan = "VOLTX - LINEMAN\nPsyon 4.1 - sync 93%\npaired: FIGHTER_B"
metadata/scan_name = "A lineman"
metadata/scan_bad = true
metadata/say = "'Say it again. SAY IT AGAIN.' He had the other one by the collar. 'He said my frames were talking to his. Like they know each other. Like we're not even here.'"

[node name="Shape" type="CollisionShape2D" parent="Actors/NpcFighterA"]
position = Vector2(0, -16)
shape = SubResource("Rect_32x32")

[node name="NpcFighterB" type="Area2D" parent="Actors"]
position = Vector2(1360, 476)
script = ExtResource("5_npc")
id = "fighter_b"
sprite_sheet = "res://assets/sprites/ezra.png"
facing = "left"
metadata/scan = "NIXTRA - COURIER\nPsyon 4.1 - sync 93%\npaired: FIGHTER_A"
metadata/scan_name = "A courier"
metadata/scan_bad = true
metadata/say = "'They ARE talking. Listen. Listen to them. Mine's saying your name.' She wasn't fighting back. She was smiling."

[node name="Shape" type="CollisionShape2D" parent="Actors/NpcFighterB"]
position = Vector2(0, -16)
shape = SubResource("Rect_32x32")

[node name="NpcDrunk" type="Area2D" parent="Actors"]
position = Vector2(304, 284)
script = ExtResource("5_npc")
id = "drunk"
sprite_sheet = "res://assets/sprites/forner.png"
facing = "down"
metadata/scan = "UNREGISTERED\nORA frames: CRACKED\ncredit: 0"
metadata/scan_name = "A drunk"
metadata/say = "'Three eyes. Three eyes on every machine in there. I've been putting money in all night and it just keeps showing me the same thing.'"

[node name="Shape" type="CollisionShape2D" parent="Actors/NpcDrunk"]
