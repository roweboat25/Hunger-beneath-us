[node name="AdHeights" type="Area2D" parent="Interactables"]
position = Vector2(672, 208)
script = ExtResource("4_interact")
id = "ad_heights"
metadata/scan = "TOKZ DISPLAY\nloop: SLEEP TOGETHER\nviews today: 414,009"
metadata/scan_name = "TOKZ display"
metadata/say = "A TOKZ ad. Sleep better. Sleep together. The couple in it faced the same way in the dark, eyes shut, and the camera held on them too long."

[node name="Shape" type="CollisionShape2D" parent="Interactables/AdHeights"]
