[node name="NpcKidHeights" type="Area2D" parent="Actors"]
position = Vector2(784, 540)
script = ExtResource("5_npc")
id = "kid_heights"
sprite_sheet = "res://assets/sprites/ezra.png"
facing = "up"
metadata/scan = "MINOR - corporate training, year 1\nPsyon JUNIOR - sync 100%"
metadata/scan_name = "Minor"
metadata/say = "'We did the breathing today. You close your eyes and you count the rings. I got to eleven.'"

[node name="Shape" type="CollisionShape2D" parent="Actors/NpcKidHeights"]
