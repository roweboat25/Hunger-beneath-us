metadata/scan = "PRIVATE SECURITY - HEIGHTS\nPsyon 4.1 - sync 91%\nlist: EVERYONE"
metadata/scan_name = "Security"
metadata/say = "'Gated community, sir. You're on the list.' He hadn't looked at anything. 'Everyone's on the list.'"

