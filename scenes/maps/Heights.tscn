[node name="Swarm" type="Area2D" parent="Interactables"]
position = Vector2(1232, 272)
script = ExtResource("4_interact")
id = "swarm"
metadata/scan = "PSYONIC LOGISTICS SWARM\nunits: 6\nroute: NOMINAL"
metadata/scan_name = "Delivery swarm"
metadata/say = "Six delivery drones over one house, in a ring. They didn't drift. Nobody was home, and the ring was waiting for someone to be."

