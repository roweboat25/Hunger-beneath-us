[node name="NpcMotherHeights" type="Area2D" parent="Actors"]
position = Vector2(336, 540)
script = ExtResource("5_npc")
id = "mother_heights"
sprite_sheet = "res://assets/sprites/nurse.png"
facing = "right"
metadata/scan = "RESIDENT - HEIGHTS\nPsyon 4.1 - sync 97%\ndependents: 1, enrolled"
metadata/scan_name = "Resident"
metadata/say = "'They put a nightlight in every room. Corporate training sent them home with it. She sleeps with her eyes open now. Is that normal? You'd know. You're Psyonic.'"

[node name="Shape" type="CollisionShape2D" parent="Actors/NpcMotherHeights"]
